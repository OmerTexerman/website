---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SEOHead from "../components/SEOHead.astro";
import { blogFeed, getRootThemeStyle, site } from "../config";

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	publishedDate?: Date;
	/** When true, hides header/footer (used for homepage 3D scene) */
	fullscreen?: boolean;
	/** When true, adds noindex robots meta tag */
	noindex?: boolean;
	/** Absolute path of the preferred URL, when this route duplicates another. */
	canonical?: string;
}

const {
	title,
	description = site.title,
	image,
	type = "website",
	publishedDate,
	fullscreen = false,
	noindex = false,
	canonical,
} = Astro.props;

const rootThemeStyle = getRootThemeStyle();
---

<!doctype html>
<html lang="en" style={rootThemeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={blogFeed.title} href="/rss.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-latin-400-normal.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/space-grotesk-latin-400.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/jetbrains-mono-latin-400.woff2" />
    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      noindex={noindex}
      canonical={canonical}
    />
    <title>{title}</title>
  </head>
  <body class={fullscreen ? "overflow-hidden h-dvh" : "min-h-screen"}>
    {!fullscreen && (
      <a
        href="#page-content"
        class="skip-link"
      >
        Skip to content
      </a>
    )}

    <slot />

    {!fullscreen && (
      <script>
        import { mountContextBackLinks } from "../dom/context-back-link";
        import { mountRevealAnimations } from "../dom/page-effects";
        import { onPageLeave } from "../dom/page-lifecycle";

        const cleanupBackLinks = mountContextBackLinks();
        const cleanupReveal = mountRevealAnimations();
        const cleanupAll = () => { cleanupBackLinks(); cleanupReveal(); };
        onPageLeave(cleanupAll);
      </script>
    )}

    <Analytics />
    <SpeedInsights />
  </body>
</html>
