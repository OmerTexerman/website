---
import type { SiteSection } from "../config";
import { getSectionPageTitle } from "../config";
import ContentShell from "./ContentShell.astro";

interface Props {
	section: SiteSection;
	surface?: boolean;
	containerWidthClass?: string;
	/** Absolute path of the preferred URL, when this route duplicates another. */
	canonical?: string;
}

const { section, surface, containerWidthClass, canonical } = Astro.props;
---

<ContentShell
  title={getSectionPageTitle(section)}
  description={section.description}
  surface={surface}
  containerWidthClass={containerWidthClass}
  canonical={canonical}
>
  <slot />
</ContentShell>
