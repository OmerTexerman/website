---
import type { PhotoGalleryPhoto } from "../dom/photo-gallery";
import { cloudinarySrcSet, cloudinaryUrl } from "../image-utils";
import { safeJson } from "../utils";

interface Props {
	photos: PhotoGalleryPhoto[];
}

const { photos } = Astro.props;

// `.photo-masonry` is 1 column below 36rem, 2 up to 64rem, then 3 inside a
// max-w-6xl container — so a thumbnail is never wider than roughly 384px on a
// large screen, and about half the viewport on a tablet.
const THUMB_WIDTHS = [320, 480, 640, 960] as const;
const THUMB_SIZES = "(min-width: 64rem) 384px, (min-width: 36rem) 45vw, 92vw";

// The lightbox reads `src` straight out of this JSON blob, so handing it a
// pre-transformed URL keeps `dom/photo-gallery.ts` unaware of Cloudinary.
const lightboxPhotos = photos.map((photo) => ({
	...photo,
	src: cloudinaryUrl(photo.src, 1600),
}));
---

<div data-photo-gallery>
  <script is:inline type="application/json" data-photo-gallery-data set:html={safeJson(lightboxPhotos)} />

  <!-- Masonry Grid -->
  <div class="photo-masonry">
    {photos.map((photo, i) => (
      <button
        type="button"
        class="photo-masonry-item group"
        data-photo-index={i}
        aria-label={`View photo: ${photo.alt}`}
      >
        <img
          src={cloudinaryUrl(photo.src, 640)}
          srcset={cloudinarySrcSet(photo.src, THUMB_WIDTHS)}
          sizes={THUMB_SIZES}
          alt={photo.alt}
          loading="lazy"
          decoding="async"
          width="600"
          height="400"
          class="photo-masonry-img"
        />
        {photo.caption && (
          <div class="photo-masonry-overlay">
            <p class="photo-masonry-caption">{photo.caption}</p>
          </div>
        )}
      </button>
    ))}
  </div>

  <!-- Lightbox -->
  <dialog
    data-photo-lightbox
    class="photo-lightbox"
    aria-label="Photo viewer"
  >
    <!-- Close -->
    <button
      data-photo-lightbox-close
      class="photo-lightbox-close"
      aria-label="Close lightbox"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Previous -->
    <button
      data-photo-lightbox-prev
      class="photo-lightbox-nav photo-lightbox-prev"
      aria-label="Previous photo"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Next -->
    <button
      data-photo-lightbox-next
      class="photo-lightbox-nav photo-lightbox-next"
      aria-label="Next photo"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Image -->
    <div class="photo-lightbox-content">
      <img
        data-photo-lightbox-img
        src=""
        alt=""
        class="photo-lightbox-image"
      />
    </div>

    <!-- Info -->
    <div class="photo-lightbox-info" aria-live="polite">
      <p data-photo-lightbox-caption class="photo-lightbox-info-caption"></p>
      <span data-photo-lightbox-counter class="photo-lightbox-info-counter font-mono"></span>
    </div>
  </dialog>
</div>

<script>
  import { onPageLeave } from "../dom/page-lifecycle";
  import { mountPhotoGalleries } from "../dom/photo-gallery";

  const cleanup = mountPhotoGalleries();
  onPageLeave(cleanup);
</script>
