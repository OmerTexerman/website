---
/**
 * Full-screen section view for the homepage scene.
 *
 * Clicking a desk object zooms the camera toward it, then this view fades
 * in over the whole screen with that section's object (notebook, laptop,
 * bookcase, corkboard) filling it. The URL changes to the section's real
 * address; Back to desk, Esc or the browser back button zoom back out.
 */
---

<div
  id="content-modal"
  class="fixed inset-0 z-50 invisible pointer-events-none"
  aria-hidden="true"
>
  <div id="content-modal-backdrop" class="modal-backdrop absolute inset-0 opacity-0"></div>
  <div
    id="content-modal-panel"
    class="modal-panel will-change-transform [backface-visibility:hidden]"
    style="opacity: 0; scale: 0.985;"
    role="dialog"
    tabindex="-1"
    aria-modal="true"
    aria-labelledby="content-modal-title"
  >
    <div id="content-modal-surface" class="modal-surface">
      {/* No header row. One close control, placed per device:
          phones: a "Back to shelf" pill at the bottom, in thumb reach
          (plus swipe down from the top, and the browser's edge swipe);
          larger screens: a small floating close button, top-right
          (plus Esc and clicking the empty room). */}
      <h2 id="content-modal-title" class="sr-only"></h2>
      <button id="content-modal-close" class="modal-close" type="button" title="Back to desk (esc)">
        <svg class="modal-close-x" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <svg class="modal-close-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="modal-close-label" data-modal-back-label>Back to desk</span>
      </button>
      <div id="content-modal-body" class="modal-body">
        <div class="flex items-center justify-center py-12">
          <div class="h-6 w-6 animate-spin rounded-full border-2 border-accent border-t-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { getBackLabel, MOBILE_BREAKPOINT, orderedSections } from "../config";
  import { mountAboutCard } from "../dom/about-card";
  import { mountOsDesktop } from "../dom/os-desktop";
  import { bootstrapContentModal } from "../modal/bootstrap";
  import { getContentModal } from "../modal/api";
  import { loadContentPreview } from "../modal/preview";

  bootstrapContentModal();

  // Re-attach the behaviour that preview HTML loses with its scripts.
  let unmountSection: (() => void) | null = null;
  document.getElementById("content-modal")?.addEventListener("content-modal:rendered", (event) => {
    unmountSection?.();
    const body = (event as CustomEvent<{ body: HTMLElement }>).detail.body;
    const unmountDesktop = mountOsDesktop(body);
    const unmountAbout = mountAboutCard(body);
    unmountSection = () => {
      unmountDesktop();
      unmountAbout();
    };
  });

  // Warm the preview cache once the page is idle, so the full-screen view
  // fades in with its content instead of a loading spinner. Phones open
  // the phone variant of Projects.
  const isPhone = window.innerWidth < MOBILE_BREAKPOINT;
  const previewHrefs = orderedSections.map(({ href }) => {
    if (isPhone && href === "/projects") return "/projects/phone";
    return href;
  });
  const warm = () => {
    const signal = new AbortController().signal;
    for (const href of previewHrefs) void loadContentPreview(href, signal).catch(() => {});
    // The laptop's wallpaper is a CSS background, so fetch it ahead too.
    if (!isPhone) new Image().src = "/wallpaper.jpg";
  };
  if ("requestIdleCallback" in window) window.requestIdleCallback(warm, { timeout: 4000 });
  else setTimeout(warm, 2000);

  // Projects has a phone version (lock screen) and a larger-screen version
  // (laptop). If the window crosses the
  // breakpoint while one is open, swap to the matching version in place.
  const PHONE_VARIANTS: Record<string, string> = {
    "/projects": "/projects/phone",
  };
  const wideQuery = window.matchMedia(`(min-width: ${MOBILE_BREAKPOINT}px)`);
  wideQuery.addEventListener("change", (event) => {
    syncBackLabel();
    const root = document.getElementById("content-modal");
    if (!root || root.classList.contains("invisible")) return;
    const path = window.location.pathname.replace(/\/$/, "");
    const wide = Object.entries(PHONE_VARIANTS).find(([, phone]) => phone === path)?.[0];
    const phone = PHONE_VARIANTS[path];
    const next = event.matches ? wide : phone;
    if (!next) return;
    const label = document.getElementById("content-modal-title")?.textContent || "";
    getContentModal()?.open(label, next);
  });

  // "Back to desk" on desktop, "Back to shelf" on phones.
  function syncBackLabel(): void {
    const backLabel = document.querySelector("[data-modal-back-label]");
    if (!backLabel) return;
    const label = getBackLabel("/");
    backLabel.textContent = label;
    backLabel.closest("button")?.setAttribute("title", `${label} (esc)`);
  }
  syncBackLabel();
</script>
