---
import { homeLink } from "../config";
import BackArrowIcon from "./BackArrowIcon.astro";

type Variant = "inline";

interface Props {
	fallbackHref?: string;
	fallbackLabel?: string;
	variant?: Variant;
	labelClass?: string;
}

const {
	fallbackHref = homeLink.href,
	fallbackLabel = homeLink.backLabel,
	variant = "inline",
	labelClass,
} = Astro.props;

const variantClass = {
	inline: "back-link back-link-inline",
}[variant];
---

<a
  data-context-back-link
  href={fallbackHref}
  class={variantClass}
  aria-label={fallbackLabel}
>
  <BackArrowIcon />
  <span data-context-back-label class={labelClass}>{fallbackLabel}</span>
</a>
