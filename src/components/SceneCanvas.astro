---
import { getFeaturedShelfBooks, getSpotlight } from "../content/selectors";
import { safeJson } from "../utils";

const featuredBooks = await getFeaturedShelfBooks();
const spotlight = await getSpotlight();
---

<div id="scene-root" class="absolute inset-0">
  <script is:inline type="application/json" data-scene-books set:html={safeJson(featuredBooks)} />
  {spotlight && <script is:inline type="application/json" data-scene-spotlight set:html={safeJson(spotlight)} />}
  <canvas
    id="scene-canvas"
    class="absolute inset-0 w-full h-full"
    role="application"
    tabindex="0"
    aria-label="Interactive 3D portfolio scene. Press Tab to move between interactive objects, Enter to open the focused one, and Escape to leave the scene. The skip link above offers plain text navigation instead."
  >
    Your browser does not support the interactive portfolio scene. Use the page navigation links instead.
  </canvas>
  {/* aria-live so the floating object label is announced as Tab moves focus
      between scene objects — without it, keyboard navigation is silent for
      screen reader users. labels.ts only rewrites textContent when the label
      actually changes, so this does not chatter during mouse hover. */}
  <div
    id="scene-labels"
    class="absolute inset-0 pointer-events-none overflow-hidden"
    aria-live="polite"
    aria-atomic="true"
  ></div>
</div>
