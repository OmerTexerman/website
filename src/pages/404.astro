---
import "../styles/notfound.css";
import ContentHeader from "../components/ContentHeader.astro";
import ContextBackLink from "../components/ContextBackLink.astro";
import { site } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`404 — Not Found | ${site.name}`} noindex>
  <ContentHeader />
  <main id="page-content" class="content-page-main lost-floor">
    {/* A note that fell off the desk, and the alien who came looking for it */}
    <div class="lost-scene">
      <div class="lost-note">
        <span class="lost-note-tape" aria-hidden="true"></span>
        <h1 class="lost-note-code">404</h1>
        <p class="lost-note-text">This page fell off the desk.</p>
        <p class="lost-note-sub">It's probably under the chair somewhere.</p>
        <ContextBackLink variant="inline" />
      </div>
      <div class="lost-alien" aria-hidden="true">
        <span class="lost-alien-q">?</span>
        <img src="/alien.svg" alt="" width="508" height="837" />
      </div>
    </div>
  </main>
</BaseLayout>
