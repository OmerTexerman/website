---
import "../../styles/projects.css";
import ProjectCard from "../../components/ProjectCard.astro";
import { getSectionById } from "../../config";
import { getOrderedProjects, getSetup } from "../../content/selectors";
import ContentPage from "../../layouts/ContentPage.astro";

const section = getSectionById("projects");
const projects = await getOrderedProjects();
const setupCategories = await getSetup();

// "About this computer" leads with the hardware entry, then lists the rest.
const hardware = setupCategories.find((c) => c.name.toLowerCase() === "hardware")?.items[0];
const otherSetup = setupCategories.filter((c) => c.name.toLowerCase() !== "hardware");

const desktopFolders = [
	{ label: "Blog", href: "/blog" },
	{ label: "Reading", href: "/reading" },
	{ label: "Photos", href: "/photos" },
];

// Icons here are CSS, not SVG: the modal preview sanitizer drops <svg>.
// Static fastfetch output. The full page types it out; the modal preview
// runs no scripts, so it shows this text as-is.
const fastfetch: [string, string][] = [
	["OS", "macOS 27.0.1 arm64"],
	["Host", "MacBook Pro (14-inch, M4 Pro)"],
	["Kernel", "Darwin 27.0.0"],
	["Shell", "zsh 5.9"],
	["Display", "3024x1964 @ 120 Hz"],
	["Terminal", "Ghostty"],
	["CPU", "Apple M4 Pro (12) @ 4.51 GHz"],
	["GPU", "Apple M4 Pro (16) [Integrated]"],
	["Memory", "24.00 GiB"],
];
---

<ContentPage section={section} surface={false} containerWidthClass="max-w-6xl">
  <script is:inline>
    if (window.innerWidth < 768) {
      window.location.replace("/projects/phone");
    }
  </script>
  <h1 class="sr-only">Projects</h1>
  <div class="os-laptop section-object" data-animate>
    <div class="os-screen">
      {/* ── Menu bar ─────────────────────────────── */}
      <div class="os-menubar">
        <div class="os-menubar-left">
          {/* No OS name: the alien sits where a logo would */}
          <img src="/alien.svg" alt="" width="508" height="837" class="os-menubar-alien" />
          <span class="os-menubar-item">File</span>
          <span class="os-menubar-item">Edit</span>
          <span class="os-menubar-item">View</span>
          <span class="os-menubar-item">Help</span>
        </div>
        <div class="os-menubar-right" aria-hidden="true">
          <span class="os-battery"><span class="os-battery-fill"></span></span>
          <time class="os-clock" id="os-clock">9:41</time>
        </div>
      </div>

      {/* ── Desktop ──────────────────────────────── */}
      <div class="os-desktop" data-os-desktop>
        <nav class="os-icons" aria-label="Other sections">
          {desktopFolders.map(({ label, href }) => (
            <a href={href} class="os-icon">
              <span class="os-folder" aria-hidden="true"></span>
              <span class="os-icon-label">{label}</span>
            </a>
          ))}
        </nav>

        {/* Projects window */}
        <section class="os-window os-window-projects" data-os-window aria-labelledby="os-projects-title">
          <header class="os-titlebar" data-os-drag>
            <span class="os-window-buttons" aria-hidden="true"><i></i><i></i><i></i></span>
            <h2 class="os-title" id="os-projects-title">Projects</h2>
            <span class="os-title-meta">{projects.length} item{projects.length === 1 ? "" : "s"}</span>
          </header>
          {projects.length > 0 && (
            <div class="os-toolbar">
              <span class="os-toolbar-icon" aria-hidden="true"></span>
              <input type="search" class="os-search" placeholder="Search projects" data-content-search aria-label="Search projects" />
            </div>
          )}
          <div class="os-window-body os-scroll">
            {projects.length === 0 ? (
              <p class="os-empty">This folder is empty.</p>
            ) : (
              <>
                <div class="os-project-list" data-content-list>
                  {projects.map((project, i) => (
                    <div data-animate style={`transition-delay: ${Math.min(i * 0.05, 0.3)}s`}>
                      <ProjectCard
                        title={project.data.title}
                        description={project.data.description}
                        tech={project.data.tech}
                        image={project.data.image}
                        url={project.data.url}
                        repo={project.data.repo}
                        post={project.data.post}
                      />
                    </div>
                  ))}
                </div>
                <p class="content-no-results" data-content-no-results role="status" aria-live="polite">No matching projects.</p>
                <button class="show-more-btn" data-show-more>Show more</button>
              </>
            )}
          </div>
        </section>

        {/* About this computer */}
        {setupCategories.length > 0 && (
          <section class="os-window os-window-about" data-os-window aria-labelledby="os-about-title">
            <header class="os-titlebar" data-os-drag>
              <span class="os-window-buttons" aria-hidden="true"><i></i><i></i><i></i></span>
              <h2 class="os-title" id="os-about-title">About this computer</h2>
            </header>
            <div class="os-window-body os-about">
              {hardware && (
                <div class="os-about-hero">
                  <span class="os-about-machine" aria-hidden="true"><span></span></span>
                  <div>
                    <p class="os-about-name">{hardware.name}</p>
                    {hardware.detail && <p class="os-about-detail">{hardware.detail}</p>}
                  </div>
                </div>
              )}
              <dl class="os-about-specs">
                {otherSetup.map((cat) => (
                  <div class="os-about-row">
                    <dt>{cat.name}</dt>
                    <dd>
                      {cat.items.map((item) => (item.detail ? `${item.name} (${item.detail})` : item.name)).join(", ")}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        )}

        {/* Terminal */}
        <section class="os-window os-window-terminal" data-os-window aria-label="Terminal">
          <header class="os-titlebar" data-os-drag>
            <span class="os-window-buttons" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="os-title">omer — zsh</span>
          </header>
          <div class="os-window-body os-terminal os-scroll">
            <p class="os-term-line">
              <span class="os-term-prompt">omer@macbook ~ %</span>
              <span id="os-ff-cmd">fastfetch</span><span class="os-cursor" id="os-ff-cursor" aria-hidden="true"></span>
            </p>
            <dl class="os-ff" id="os-ff">
              {fastfetch.map(([key, value]) => (
                <div class="os-ff-row">
                  <dt>{key}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
              <div class="os-ff-swatches" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
            </dl>
          </div>
        </section>
      </div>
    </div>
    <div class="os-laptop-base" aria-hidden="true"></div>
  </div>
</ContentPage>

<script>
  import "../../dom/content-list-boot";
  import { mountOsDesktop } from "../../dom/os-desktop";
  import { onPageLeave } from "../../dom/page-lifecycle";

  onPageLeave(mountOsDesktop());
</script>
